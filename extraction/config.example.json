{
  "project_name": "my_project",
  "output_dir": "./my_project_docs_extracted",
  "use_token_chunking": false,
  "_comment_token_chunking": "Token chunking is more precise but MUCH slower (use false for large datasets)",

  "modules": {
    "MODULE_A": {
      "description": "What this module does",
      "dev_path": "./module_a/html",
      "user_path": "./module_a/html_gui"
    },
    "MODULE_B": {
      "description": "What this module does",
      "dev_path": "./module_b/html",
      "user_path": "./module_b/html_gui"
    }
  },

  "embedding": {
    "model": "sentence-transformers/all-MiniLM-L6-v2",
    "_comment": "Must match the embedding.model in chatbot/config.json — mismatch causes silent wrong retrieval",
    "similarity_metric": "cosine"
  },

  "chunking": {
    "max_tokens": 384,
    "overlap_tokens": 50,
    "char_chunk_size": 1000,
    "char_overlap": 200
  },

  "quality": {
    "min_score": 0.3,
    "min_word_count": 50,
    "substantial_word_count": 100
  }
}
